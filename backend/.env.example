# ─────────────────────────────────────────────
# Food-Safe Backend — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in the values below.
# Never commit .env to version control.
# ─────────────────────────────────────────────

# ── Google AI Studio ─────────────────────────
# Get your key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_google_ai_studio_api_key

# ── AI Model Selection ────────────────────────
# Primary models require Gemma 4 access on your key.
# Fallback models run on standard Gemini quota.
VISION_MODEL=gemma-4-31b-it
VISION_FALLBACK_MODEL=gemini-2.5-flash
REASONING_MODEL=gemma-4-31b-it
REASONING_FALLBACK_MODEL=gemini-2.5-flash

# ── Database ──────────────────────────────────
# PostgreSQL connection string (Supabase recommended).
# If this is missing, the app falls back to local SQLite — fine for local dev.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB
# URL-encode special characters in the password (e.g. @ → %40).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres

# ── JWT Auth ──────────────────────────────────
# Any long random string. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-secret

# ── ChromaDB ──────────────────────────────────
# Set CHROMA_USE_CLOUD=false for local persistent Chroma (recommended for dev).
# Set to true and fill the cloud vars below for production.
CHROMA_USE_CLOUD=false
CHROMA_COLLECTION=food-safe-toxicology
CHROMA_PERSIST_DIRECTORY=knowledge/chroma

# Required only when CHROMA_USE_CLOUD=true:
CHROMA_API_KEY=your_chroma_cloud_api_key
CHROMA_TENANT=your_chroma_tenant_id
CHROMA_DATABASE=your_chroma_database_name

# ── RAG ───────────────────────────────────────
# Number of document chunks retrieved per ingredient query.
CHROMA_TOP_K=3

# ── Optional ──────────────────────────────────
MARKET_API_BASE_URL=https://market-api.example.com
